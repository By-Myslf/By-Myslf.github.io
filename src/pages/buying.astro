---
// The "I buy" page: what the collector is looking for, and how to offer items.
// The email address comes from src/site.config.ts.
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { mailto, url } from '../lib/helpers';

const offerLink = mailto(site.email, 'Offer: champagne items');

// What I'm looking for. Add, remove or reword freely.
const wanted = [
  ['Champagne glasses', 'Coupes, flutes and complete services, from pressed glass to engraved crystal.'],
  ['Ice buckets and coolers', 'Silver, silver plate, pewter and enamel, with or without stands.'],
  ['Stoppers, taps and openers', 'Clamp stoppers, champagne taps, cork pliers and cases.'],
  ['Muselet caps', 'Single rare caps, albums and entire collections.'],
  ['Labels and ephemera', 'Labels, menus, price lists, posters and advertising.'],
  ['Champagne house items', 'Trays, ashtrays, signs and gifts made for a champagne house.'],
];

const steps = [
  ['Send photos', 'A few clear photos, the size, any marks or names, and what you know about the history.'],
  ['Get a reply', 'I answer every message, usually within a few days, with questions or an offer.'],
  ['Agree and hand over', 'Payment on collection in Budapest, or by arrangement with insured shipping.'],
];
---

<Base
  title="I buy"
  description="I buy vintage champagne-related items and complete collections: glasses, ice buckets, stoppers, muselet caps, labels and more."
>
  <section class="buy-hero">
    <div class="wrap">
      <p class="buy-kicker">Selling a piece or a collection?</p>
      <h1>I buy vintage champagne-related items and complete collections.</h1>
      <p class="buy-intro">
        From a single coupe to a lifetime's collection, I'm always glad to hear about objects
        connected with champagne and its history. Every offer gets a personal reply.
      </p>
      <a class="button on-wall-button" href={offerLink}>Offer an item</a>
    </div>
  </section>

  <div class="wrap">
    <section class="section" aria-labelledby="wanted">
      <div class="section-head">
        <h2 id="wanted">What I'm looking for</h2>
        <a href={url('catalogue/')}>See the collection</a>
      </div>
      <ul class="wanted-grid">
        {
          wanted.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="how">
      <div class="section-head">
        <h2 id="how">How it works</h2>
      </div>
      <ol class="steps">
        {
          steps.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section buy-collections" aria-labelledby="collections">
      <div class="reading-col">
        <h2 id="collections">Complete collections</h2>
        <div class="prose">
          <p>
            If you are selling a whole collection, or clearing a house or an estate, I'm happy to
            look at everything together and make one offer for the lot. Collections stay together
            wherever possible, and their history is recorded in the catalogue.
          </p>
          <p>Everything you send is treated in confidence.</p>
        </div>
      </div>

      <div class="contact-box">
        <p class="address">{site.email}</p>
        <div class="actions">
          <a class="button" href={offerLink}>Offer an item</a>
          <a class="button quiet" href={url('contact/')}>Other questions</a>
        </div>
      </div>
    </section>
  </div>
</Base>
