---
// The home page.
import Base from '../layouts/Base.astro';
import ObjectCard from '../components/ObjectCard.astro';
import { getObjects, getPosts, getArticles } from '../lib/content';
import { url, img, formatDate } from '../lib/helpers';

const objects = await getObjects();
const featured = objects.filter((o) => o.data.featured);

// The first featured object hangs on the green wall at the top
const hero = featured[0] ?? objects[0];
const highlights = (featured.length > 1 ? featured : objects).filter((o) => o !== hero).slice(0, 6);

const posts = (await getPosts()).slice(0, 3);
const articles = (await getArticles()).slice(0, 3);
---

<Base onWall>
  <section class="wall">
    <div class="wrap wall-grid">
      {
        hero && (
          <a class="hung" href={url(`catalogue/${hero.id}/`)}>
            <div class:list={['mat', { empty: !hero.data.images[0] }]}>
              {hero.data.images[0] && (
                <img src={img('catalogue', hero.data.images[0])} alt={hero.data.title} />
              )}
            </div>
          </a>
        )
      }

      <div class="wall-text">
        <h1>Objects collected slowly, over many years</h1>
        <p class="intro">
          A private collection of antiques and works of art. Each piece is catalogued here with
          its history, alongside my notes and essays by specialists I admire.
        </p>
        <a class="button on-wall-button" href={url('catalogue/')}>Browse the catalogue</a>

        {
          hero && (
            <p class="label">
              <span class="no">No. {hero.data.number}</span>
              <a class="title" href={url(`catalogue/${hero.id}/`)}>{hero.data.title}</a>
              <span class="meta">
                {[hero.data.maker, hero.data.date, hero.data.materials].filter(Boolean).join(', ')}
              </span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <div class="wrap">
    {
      highlights.length > 0 && (
        <section class="section" aria-labelledby="from-catalogue">
          <div class="section-head">
            <h2 id="from-catalogue">From the catalogue</h2>
            <a href={url('catalogue/')}>See all {objects.length} objects</a>
          </div>
          <ul class="object-grid">
            {highlights.map((item) => (
              <ObjectCard item={item} />
            ))}
          </ul>
        </section>
      )
    }

    {(posts.length > 0 || articles.length > 0) && (
    <div class="section two-col">
      {posts.length > 0 && (
      <section aria-labelledby="latest-journal">
        <div class="section-head">
          <h2 id="latest-journal">Journal</h2>
          <a href={url('journal/')}>All posts</a>
        </div>
        <ul class="entry-list">
          {
            posts.map((post) => (
              <li>
                <a href={url(`journal/${post.id}/`)}>
                  <span class="small">{formatDate(post.data.date)}</span>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.summary}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      )}

      {articles.length > 0 && (
      <section aria-labelledby="latest-articles">
        <div class="section-head">
          <h2 id="latest-articles">Collector's guide</h2>
          <a href={url('guide/')}>All guides</a>
        </div>
        <ul class="entry-list">
          {
            articles.map((article) => (
              <li>
                <a href={url(`guide/${article.id}/`)}>
                  <span class="small">{article.data.author}</span>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.summary}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      )}
    </div>
    )}

    <section class="section">
      <a class="buy-callout" href={url('buying/')}>
        <span class="buy-callout-kicker">I buy</span>
        <span class="buy-callout-text">Vintage champagne-related items and complete collections.</span>
        <span class="buy-callout-link">How selling to me works</span>
      </a>
    </section>
  </div>
</Base>
