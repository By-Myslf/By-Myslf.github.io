---
// The page for a single object. One is made automatically for every
// Markdown file in src/content/catalogue/.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getObjects } from '../../lib/content';
import { site } from '../../site.config';
import { url, img, mailto } from '../../lib/helpers';

export async function getStaticPaths() {
  const objects = await getObjects();
  return objects.map((item, i) => ({
    params: { id: item.id },
    props: { item, prev: objects[i - 1], next: objects[i + 1] },
  }));
}

const { item, prev, next } = Astro.props;
const { Content } = await render(item);
const d = item.data;

const allFacts: [string, string | undefined][] = [
  ['Item type', d.category],
  ['Brand', d.brand],
  ['Date', d.date],
  ['Maker', d.maker],
  ['Origin', d.origin],
  ['Materials', d.materials],
  ['Dimensions', d.dimensions],
];
const facts = allFacts.filter((f): f is [string, string] => Boolean(f[1]));

const photos = d.images.map((file) => img('catalogue', file));
---

<Base title={d.title} description={`No. ${d.number}: ${d.title}, ${d.date}`}>
  <div class="wrap">
    <a class="back" href={url('catalogue/')}>Back to the catalogue</a>

    <article class="object-page">
      <div class="gallery">
        <div class:list={['mat', { empty: photos.length === 0 }]}>
          {photos[0] && <img id="main-photo" src={photos[0]} alt={d.title} />}
        </div>
        {
          photos.length > 1 && (
            <ul class="thumbs" aria-label="More photos">
              {photos.map((src, i) => (
                <li>
                  <button type="button" data-src={src} aria-current={i === 0 ? 'true' : 'false'}>
                    <img src={src} alt={`Photo ${i + 1} of ${photos.length}`} loading="lazy" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="object-info">
        <p class="no">No. {d.number}</p>
        <h1>{d.title}</h1>

        <dl class="facts">
          {
            facts.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>
                  {label === 'Item type' ? (
                    <a href={url(`catalogue/?category=${encodeURIComponent(value)}`)}>{value}</a>
                  ) : label === 'Brand' ? (
                    <a href={url(`catalogue/?brand=${encodeURIComponent(value)}`)}>{value}</a>
                  ) : (
                    value
                  )}
                </dd>
              </>
            ))
          }
        </dl>

        <div class="prose">
          <Content />
        </div>

        <div class="enquire">
          <a class="button" href={mailto(site.email, `About No. ${d.number}: ${d.title}`)}>
            Write to me about this piece
          </a>
        </div>
      </div>
    </article>

    <nav class="pager" aria-label="Other objects">
      {
        prev && (
          <a class="prev" href={url(`catalogue/${prev.id}/`)}>
            <small>Previous</small>
            <span>{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="next" href={url(`catalogue/${next.id}/`)}>
            <small>Next</small>
            <span>{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </div>
</Base>

<script>
  const main = document.querySelector<HTMLImageElement>('#main-photo');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumbs button')];

  for (const t of thumbs) {
    t.addEventListener('click', () => {
      if (!main || !t.dataset.src) return;
      main.src = t.dataset.src;
      for (const other of thumbs) other.setAttribute('aria-current', String(other === t));
    });
  }
</script>
