---
import Base from '../layouts/Base.astro';
import { url } from '../lib/helpers';
---

<Base title="Page not found">
  <div class="wrap">
    <article class="reading">
      <h1>This page isn't here</h1>
      <p class="lead">The link may be old, or the piece may have been renamed.</p>
      <p><a class="button" href={url('catalogue/')}>Go to the catalogue</a></p>
    </article>
  </div>
</Base>
