---
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/content';
import { url, formatDate } from '../../lib/helpers';

const articles = await getArticles();
---

<Base title="Articles" description="Essays on antiques and art by specialists and the collector.">
  <div class="wrap">
    <header class="page-head">
      <h1>Articles</h1>
      <p>Longer essays on makers, materials and periods, written by specialists and by me.</p>
    </header>

    {
      articles.length === 0 ? (
        <p class="small">No articles yet.</p>
      ) : (
        <ul class="entry-list wide">
          {articles.map((article) => (
            <li>
              <a href={url(`articles/${article.id}/`)}>
                <span class="small">
                  {article.data.author}
                  {article.data.authorRole && `, ${article.data.authorRole}`}
                </span>
                <h3>{article.data.title}</h3>
                <p>{article.data.summary}</p>
                <span class="small">{formatDate(article.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
