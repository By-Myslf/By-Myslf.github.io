 "slug": "ritka-4-palackos-vintage-medici-tipusu-ezustozott-pezsgohuto-a-charles-heidsieck-champagne-haztol-1970-es-evek-franciaorszag-elado",
 "link": "https://champagneclub.hu/ritka-4-palackos-vintage-medici-tipusu-ezustozott-pezsgohuto-a-charles-heidsieck-champagne-haztol-1970-es-evek-franciaorszag-elado/",
 "title": "Medici típusú 4 palackos pezsgőhűtő a Charles Heidsieck Champagne-háztól – 1970-es évek",
 "categories": [
  77
 ],
 "tags": [
